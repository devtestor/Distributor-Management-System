DATABASE_URL="postgresql://postgres:postgres@localhost:5432/human_concept_erp?schema=public"
API_PORT=4000
JWT_SECRET="replace-this-with-a-long-random-secret"
JWT_EXPIRES_IN="1h"
WEB_ORIGIN="http://localhost:3001"
NEXT_PUBLIC_API_URL="/api"

# Vercel frontend deployment:
# Set NEXT_PUBLIC_API_URL to /api when the frontend and API share the same Vercel app.
# Set WEB_ORIGIN in the API environment to the Vercel frontend URL.
