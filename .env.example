DATABASE_URL="postgresql://postgres:postgres@localhost:5432/human_concept_erp?schema=public"
API_PORT=4000
JWT_SECRET="replace-this-with-a-long-random-secret"
JWT_EXPIRES_IN="1h"
WEB_ORIGIN="http://localhost:3001"
NEXT_PUBLIC_API_URL="/api"

# Render deployment:
# API service uses PORT from Render automatically, DATABASE_URL, JWT_SECRET, JWT_EXPIRES_IN, and WEB_ORIGIN.
# Web service uses NEXT_PUBLIC_API_URL=https://your-api-service.onrender.com.
# The frontend appends /api automatically when NEXT_PUBLIC_API_URL is a plain service origin.
