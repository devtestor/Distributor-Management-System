generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  en
  fr
  rw
  sw
}

enum ProductCategory {
  BEER
  SOFT_DRINK
  WATER
  OTHER
}

enum PackageType {
  BOTTLE_CRATE
  CAN_TRAY
  PET_PACK
  SINGLE_UNIT
}

enum StockMovementType {
  PURCHASE_RECEIPT
  SALE_ISSUE
  TRUCK_LOAD
  TRUCK_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  LOSS
  COUNT_ADJUSTMENT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK
  CREDIT
}

enum PaymentReconciliationStatus {
  PENDING
  MATCHED
  FLAGGED
}

enum EBMStatus {
  NOT_SUBMITTED
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum EmptyMovementType {
  ISSUED_TO_CUSTOMER
  RETURNED_BY_CUSTOMER
  ADJUSTMENT
  LOST
}

enum DeliveryStatus {
  LOADING
  ON_ROUTE
  RECONCILIATION
  CLOSED
  CANCELLED
}

enum DebtCollectionActionType {
  CALL
  VISIT
  SMS
  WHATSAPP
  PROMISE_TO_PAY
  PAYMENT_REMINDER
  ACCOUNT_BLOCKED
  NOTE
}

enum DebtCollectionStatus {
  OPEN
  COMPLETED
  MISSED
  CANCELLED
}

model Company {
  id                       String                   @id @default(uuid())
  name                     String
  code                     String                   @unique
  industry                 String                   @default("Beverage distribution")
  logoUrl                  String?
  primaryColor             String                   @default("#0b6b50")
  secondaryColor           String                   @default("#f4c542")
  currency                 String                   @default("RWF")
  defaultLocale            Locale                   @default(en)
  featureFlags             Json?
  createdAt                DateTime                 @default(now())
  users                    User[]
  products                 Product[]
  productPriceHistory      ProductPriceHistory[]
  warehouses               Warehouse[]
  customers                Customer[]
  stockMovements           StockMovement[]
  invoices                 Invoice[]
  payments                 Payment[]
  emptyContainerMovements  EmptyContainerMovement[]
  vehicles                 Vehicle[]
  deliveryTrips            DeliveryTrip[]
  deliveryProofs           DeliveryProof[]
  debtCollectionActivities DebtCollectionActivity[]
  expenses                 Expense[]
  auditLogs                AuditLog[]
  invoiceSequences         InvoiceSequence[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
}

model User {
  id                       String                   @id @default(uuid())
  companyId                String
  company                  Company                  @relation(fields: [companyId], references: [id])
  roleId                   String
  role                     Role                     @relation(fields: [roleId], references: [id])
  fullName                 String
  phone                    String?
  email                    String?                  @unique
  passwordHash             String
  preferredLocale          Locale                   @default(en)
  isActive                 Boolean                  @default(true)
  createdAt                DateTime                 @default(now())
  stockMovements           StockMovement[]
  invoices                 Invoice[]
  payments                 Payment[]
  emptyContainerMovements  EmptyContainerMovement[]
  drivenVehicles           Vehicle[]                @relation("VehicleDriver")
  deliveryTrips            DeliveryTrip[]
  deliveryProofs           DeliveryProof[]
  reconciledPayments       Payment[]                @relation("PaymentReconciledBy")
  debtCollectionActivities DebtCollectionActivity[]
  expenses                 Expense[]
  auditLogs                AuditLog[]
  productPriceHistory      ProductPriceHistory[]

  @@index([companyId])
  @@index([roleId])
}

model Product {
  id                      String                   @id @default(uuid())
  companyId               String
  company                 Company                  @relation(fields: [companyId], references: [id])
  sku                     String
  name                    String
  brand                   String
  category                ProductCategory
  packageType             PackageType
  unitSize                String
  unitCost                Decimal                  @db.Decimal(14, 2)
  unitPrice               Decimal                  @db.Decimal(14, 2)
  reorderLevel            Int                      @default(0)
  tracksEmpties           Boolean                  @default(false)
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  stockMovements          StockMovement[]
  invoiceItems            InvoiceItem[]
  emptyContainerMovements EmptyContainerMovement[]
  deliveryTripItems       DeliveryTripItem[]
  priceHistory            ProductPriceHistory[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([category])
  @@index([isActive])
}

model ProductPriceHistory {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  previousCost  Decimal? @db.Decimal(14, 2)
  newCost       Decimal  @db.Decimal(14, 2)
  previousPrice Decimal? @db.Decimal(14, 2)
  newPrice      Decimal  @db.Decimal(14, 2)
  changedById   String?
  changedBy     User?    @relation(fields: [changedById], references: [id])
  changeReason  String?
  createdAt     DateTime @default(now())

  @@index([companyId])
  @@index([productId])
  @@index([changedById])
  @@index([createdAt])
}

model Warehouse {
  id             String          @id @default(uuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id])
  name           String
  location       String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  stockMovements StockMovement[]

  @@index([companyId])
}

model Customer {
  id                       String                   @id @default(uuid())
  companyId                String
  company                  Company                  @relation(fields: [companyId], references: [id])
  name                     String
  phone                    String?
  route                    String?
  location                 String?
  creditLimit              Decimal                  @default(0) @db.Decimal(14, 2)
  isActive                 Boolean                  @default(true)
  createdAt                DateTime                 @default(now())
  invoices                 Invoice[]
  payments                 Payment[]
  emptyContainerMovements  EmptyContainerMovement[]
  deliveryProofs           DeliveryProof[]
  debtCollectionActivities DebtCollectionActivity[]

  @@index([companyId])
  @@index([route])
  @@index([isActive])
}

model StockMovement {
  id            String            @id @default(uuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id])
  productId     String
  product       Product           @relation(fields: [productId], references: [id])
  warehouseId   String
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])
  movementType  StockMovementType
  quantity      Int
  unitCost      Decimal?          @db.Decimal(14, 2)
  referenceType String?
  referenceId   String?
  note          String?
  createdById   String
  createdBy     User              @relation(fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())

  @@index([companyId])
  @@index([productId])
  @@index([warehouseId])
  @@index([movementType])
  @@index([createdAt])
}

model Invoice {
  id                       String                   @id @default(uuid())
  companyId                String
  company                  Company                  @relation(fields: [companyId], references: [id])
  customerId               String
  customer                 Customer                 @relation(fields: [customerId], references: [id])
  invoiceNumber            String
  status                   InvoiceStatus            @default(DRAFT)
  paymentStatus            PaymentStatus            @default(UNPAID)
  totalAmount              Decimal                  @db.Decimal(14, 2)
  taxRate                  Decimal                  @default(18.00) @db.Decimal(5, 2)
  taxAmount                Decimal                  @default(0) @db.Decimal(14, 2)
  ebmStatus                EBMStatus                @default(NOT_SUBMITTED)
  ebmReceiptNumber         String?
  ebmSdcId                 String?
  ebmSignature             String?
  ebmSubmittedAt           DateTime?
  createdById              String
  createdBy                User                     @relation(fields: [createdById], references: [id])
  createdAt                DateTime                 @default(now())
  items                    InvoiceItem[]
  payments                 Payment[]
  debtCollectionActivities DebtCollectionActivity[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([customerId])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([ebmStatus])
}

model InvoiceSequence {
  id         String   @id
  companyId  String   @unique
  company    Company  @relation(fields: [companyId], references: [id])
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model InvoiceItem {
  id             String  @id @default(uuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id])
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  quantity       Int
  unitPrice      Decimal @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  lineTotal      Decimal @db.Decimal(14, 2)

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id                   String                      @id @default(uuid())
  companyId            String
  company              Company                     @relation(fields: [companyId], references: [id])
  customerId           String
  customer             Customer                    @relation(fields: [customerId], references: [id])
  invoiceId            String?
  invoice              Invoice?                    @relation(fields: [invoiceId], references: [id])
  method               PaymentMethod
  amount               Decimal                     @db.Decimal(14, 2)
  reference            String?
  reconciliationStatus PaymentReconciliationStatus @default(PENDING)
  reconciliationNote   String?
  reconciledAt         DateTime?
  reconciledById       String?
  reconciledBy         User?                       @relation("PaymentReconciledBy", fields: [reconciledById], references: [id])
  receivedById         String
  receivedBy           User                        @relation(fields: [receivedById], references: [id])
  receivedAt           DateTime                    @default(now())

  @@index([companyId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([reconciliationStatus])
  @@index([receivedAt])
}

model EmptyContainerMovement {
  id            String            @id @default(uuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id])
  customerId    String
  customer      Customer          @relation(fields: [customerId], references: [id])
  productId     String?
  product       Product?          @relation(fields: [productId], references: [id])
  movementType  EmptyMovementType
  quantity      Int
  referenceType String?
  referenceId   String?
  createdById   String
  createdBy     User              @relation(fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())

  @@index([companyId])
  @@index([customerId])
  @@index([productId])
  @@index([createdAt])
}

model Vehicle {
  id          String         @id @default(uuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id])
  plateNumber String
  driverId    String?
  driver      User?          @relation("VehicleDriver", fields: [driverId], references: [id])
  isActive    Boolean        @default(true)
  trips       DeliveryTrip[]

  @@unique([companyId, plateNumber])
  @@index([companyId])
}

model DeliveryTrip {
  id            String             @id @default(uuid())
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id])
  vehicleId     String
  vehicle       Vehicle            @relation(fields: [vehicleId], references: [id])
  driverId      String
  driver        User               @relation(fields: [driverId], references: [id])
  route         String
  status        DeliveryStatus     @default(LOADING)
  cashCollected Decimal            @default(0) @db.Decimal(14, 2)
  creditIssued  Decimal            @default(0) @db.Decimal(14, 2)
  loadedAt      DateTime?
  returnedAt    DateTime?
  createdAt     DateTime           @default(now())
  items         DeliveryTripItem[]
  proofs        DeliveryProof[]

  @@index([companyId])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
}

model DeliveryTripItem {
  id                String       @id @default(uuid())
  tripId            String
  trip              DeliveryTrip @relation(fields: [tripId], references: [id])
  productId         String
  product           Product      @relation(fields: [productId], references: [id])
  loadedQuantity    Int
  deliveredQuantity Int          @default(0)
  returnedQuantity  Int          @default(0)
  damagedQuantity   Int          @default(0)

  @@index([tripId])
  @@index([productId])
}

model DeliveryProof {
  id               String       @id @default(uuid())
  companyId        String
  company          Company      @relation(fields: [companyId], references: [id])
  tripId           String
  trip             DeliveryTrip @relation(fields: [tripId], references: [id])
  customerId       String?
  customer         Customer?    @relation(fields: [customerId], references: [id])
  receiverName     String
  receiverPhone    String?
  deliveredAt      DateTime     @default(now())
  latitude         Decimal?     @db.Decimal(10, 7)
  longitude        Decimal?     @db.Decimal(10, 7)
  signatureDataUrl String?
  photoUrl         String?
  note             String?
  createdById      String
  createdBy        User         @relation(fields: [createdById], references: [id])
  createdAt        DateTime     @default(now())

  @@index([companyId])
  @@index([tripId])
  @@index([customerId])
  @@index([createdAt])
}

model DebtCollectionActivity {
  id             String                   @id @default(uuid())
  companyId      String
  company        Company                  @relation(fields: [companyId], references: [id])
  customerId     String
  customer       Customer                 @relation(fields: [customerId], references: [id])
  invoiceId      String?
  invoice        Invoice?                 @relation(fields: [invoiceId], references: [id])
  actionType     DebtCollectionActionType
  status         DebtCollectionStatus     @default(OPEN)
  note           String?
  promisedAmount Decimal?                 @db.Decimal(14, 2)
  promisedDate   DateTime?
  nextFollowUpAt DateTime?
  createdById    String
  createdBy      User                     @relation(fields: [createdById], references: [id])
  completedAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([companyId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([status])
  @@index([nextFollowUpAt])
  @@index([createdAt])
}

model Expense {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  category  String
  amount    Decimal  @db.Decimal(14, 2)
  note      String?
  spentById String?
  spentBy   User?    @relation(fields: [spentById], references: [id])
  spentAt   DateTime @default(now())

  @@index([companyId])
  @@index([category])
  @@index([spentAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}
