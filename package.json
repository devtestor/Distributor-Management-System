{
  "name": "human-concept-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "web:dev": "next dev",
    "build": "next build",
    "start": "next start",
    "api:dev": "NODE_OPTIONS=--dns-result-order=ipv4first tsx watch --tsconfig apps/api/tsconfig.json apps/api/src/main.ts",
    "api:build": "tsc -p apps/api/tsconfig.build.json",
    "api:start": "NODE_OPTIONS=--dns-result-order=ipv4first node dist/api/main.js",
    "render:api:build": "npm ci --include=dev && npm run prisma:generate && npm run prisma:deploy && npm run api:build",
    "render:api:start": "npm run api:start",
    "render:web:build": "npm ci --include=dev && npm run build",
    "render:web:start": "npm run start",
    "lint": "eslint app lib apps/api prisma --max-warnings=0",
    "test": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json node --import tsx --test \"apps/api/src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc -p apps/api/tsconfig.json --noEmit",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "docker:build": "docker build -t distributor-management-system .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app api"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.468.0",
    "next": "15.5.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/bcryptjs": "^2.4.6",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.2",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2"
  }
}
